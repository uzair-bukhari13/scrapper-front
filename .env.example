BACKEND_API_URL=http://localhost:5050
DASHBOARD_API_KEY=your_private_dashboard_api_key
# Browser-visible values used by the Socket.IO client. The key must match
# DASHBOARD_API_KEY because the current private dashboard authenticates sockets directly.
NEXT_PUBLIC_BACKEND_SOCKET_URL=http://localhost:5050
NEXT_PUBLIC_DASHBOARD_API_KEY=$DASHBOARD_API_KEY
